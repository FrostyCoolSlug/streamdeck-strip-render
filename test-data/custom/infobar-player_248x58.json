{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "infobar-player",
  "items": [
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [6, 6, 46, 46]
    },
    {
      "key": "title",
      "type": "text",
      "rect": [60, 6, 180, 20],
      "font": { "size": 13, "weight": 700 },
      "value": "Now Playing"
    },
    {
      "key": "subtitle",
      "type": "text",
      "rect": [60, 26, 180, 16],
      "font": { "size": 11, "weight": 400 },
      "color": "#888888",
      "value": "Volume 70%"
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [60, 44, 180, 8],
      "range": { "min": 0, "max": 100 },
      "value": 70,
      "subtype": 0,
      "border_w": 0,
      "bar_bg_c": "#333333",
      "bar_fill_c": "#33cc66"
    }
  ]
}
