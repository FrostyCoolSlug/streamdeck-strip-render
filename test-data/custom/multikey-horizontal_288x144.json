{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "multikey-horizontal",
  "items": [
    {
      "key": "album_art",
      "type": "pixmap",
      "rect": [16, 20, 72, 72]
    },
    {
      "key": "title",
      "type": "text",
      "rect": [104, 22, 168, 26],
      "font": { "size": 18, "weight": 700 },
      "value": "Tom's Diner"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [104, 52, 170, 20],
      "font": { "size": 13, "weight": 400 },
      "color": "#aaaaaa",
      "value": "AnnenMayKantereit"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [196, 78, 76, 16],
      "font": { "size": 11, "weight": 400 },
      "alignment": "right",
      "color": "#666666",
      "value": "2:15 / 4:29"
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [16, 102, 256, 18],
      "range": { "min": 0, "max": 100 },
      "value": 50,
      "subtype": 0,
      "border_w": 0,
      "bar_bg_c": "#222222",
      "bar_fill_c": "#1db954"
    }
  ]
}
